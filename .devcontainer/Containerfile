FROM quay.io/fedora/fedora:43@sha256:0cdfbfa1b9a80483e9adc87f2b294feee71fd98d9c33f5f3758d10f95c980f16

ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1
ENV SHELL=/usr/bin/fish

RUN dnf install -y \
    python3 \
    python3-pip \
    git \
    make \
    fish \
    sudo \
    && dnf clean all

COPY --from=ghcr.io/astral-sh/uv:latest@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /usr/local/bin/uv

# Create vscode user with sudo access and fish shell
RUN useradd -m -s /usr/bin/fish vscode && \
    echo "vscode ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/vscode

WORKDIR /workspace
