FROM quay.io/fedora/fedora:46@sha256:b2aa086320a7649fc22c67fbff19a6c877e7f78a7d554b6d16586a5635e72dea

ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1
ENV SHELL=/usr/bin/fish

RUN dnf install -y \
    python3 \
    python3-pip \
    git \
    make \
    fish \
    sudo \
    && dnf clean all

COPY --from=ghcr.io/astral-sh/uv:latest@sha256:95f2aa1fe59274951cfe9b0cbc7972e879ff1004bc8945d130a32eb0dbd85945 /uv /usr/local/bin/uv

# Create vscode user with sudo access and fish shell
RUN useradd -m -s /usr/bin/fish vscode && \
    echo "vscode ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/vscode

WORKDIR /workspace
