FROM quay.io/fedora/fedora:43@sha256:d9c079f2727706bfe335fefae57c7518a84e97daf4b1bf9d50fb3e8a75e7e78c

ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1
ENV SHELL=/usr/bin/fish

RUN dnf install -y \
    python3 \
    python3-pip \
    git \
    make \
    fish \
    sudo \
    && dnf clean all

COPY --from=ghcr.io/astral-sh/uv:latest@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /usr/local/bin/uv

# Create vscode user with sudo access and fish shell
RUN useradd -m -s /usr/bin/fish vscode && \
    echo "vscode ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/vscode

WORKDIR /workspace
