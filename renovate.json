{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rhel-lightspeed/renovate-config"],
  "packageRules": [
    {
      "description": "Only update uv.lock for Python packages",
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip-compile",
        "poetry",
        "pipenv"
      ],
      "rangeStrategy": "in-range-only"
    }
  ]
}
